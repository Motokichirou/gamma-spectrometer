(rule "внутри корпуса C18b201"
	(constraint clearance (min 0mm))
	(condition "A.insideCourtyard('C18b201') && B.insideCourtyard('C18b201')"))
(rule "внутри корпуса C14b201"
	(constraint clearance (min 0mm))
	(condition "A.insideCourtyard('C14b201') && B.insideCourtyard('C14b201')"))
(rule "внутри корпуса C15b201"
	(constraint clearance (min 0mm))
	(condition "A.insideCourtyard('C15b201') && B.insideCourtyard('C15b201')"))
(rule "внутри корпуса C13b201"
	(constraint clearance (min 0mm))
	(condition "A.insideCourtyard('C13b201') && B.insideCourtyard('C13b201')"))
(rule "внутри корпуса C16b201"
	(constraint clearance (min 0mm))
	(condition "A.insideCourtyard('C16b201') && B.insideCourtyard('C16b201')"))
(rule "внутри корпуса Q403"
	(constraint clearance (min 0mm))
	(condition "A.insideCourtyard('Q403') && B.insideCourtyard('Q403')"))
(rule "внутри корпуса C17b201"
	(constraint clearance (min 0mm))
	(condition "A.insideCourtyard('C17b201') && B.insideCourtyard('C17b201')"))

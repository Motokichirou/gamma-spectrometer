# ----------------------------------------------------------------------
# ИСКЛЮЧЕНИЯ: компоненты, которые ПО СХЕМЕ соединяют ВВ-узел с землёй.
# У них ВВ и GND на собственных выводах, зазор задан корпусом детали и
# перемещением не лечится. Электрическую прочность здесь держит рабочее
# напряжение самого компонента, а не расстояние по плате.
# Ставятся ПОСЛЕ основных правил — приоритет у последнего совпавшего.
# ----------------------------------------------------------------------
(rule "внутри корпуса T201"
	(constraint clearance (min 0mm))
	(condition "A.insideCourtyard('T201') && B.insideCourtyard('T201')"))
(rule "внутри корпуса C210"
	(constraint clearance (min 0mm))
	(condition "A.insideCourtyard('C210') && B.insideCourtyard('C210')"))
(rule "внутри корпуса D205"
	(constraint clearance (min 0mm))
	(condition "A.insideCourtyard('D205') && B.insideCourtyard('D205')"))

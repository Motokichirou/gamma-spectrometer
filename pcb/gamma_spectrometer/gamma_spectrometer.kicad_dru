(version 1)
# Зазоры высоковольтных цепей до земли: 3 мм на 1 кВ.
# Норма от инженера-референса (4 кВ переменки -> 12 мм) + сверка с IPC-2221 B1
# (без паяльной маски: 0.25 мм + 0.0025 мм/В -> 4.0 мм при 1500 В).
# ЛУТ-прототип идёт без маски, поэтому считаем по B1, а не по B4.
# Потенциалы взяты из рабочей точки делителя и структуры CW/цепочек ОС и монитора.
# Правила ограничивают ТОЛЬКО пару <ВВ-цепь> - <GND>. Зазоры между соседними
# ступенями ВВ намеренно не трогаем: там разность ~150-190 В (принцип градиента).
# Сгенерировано 2026-08-07.

(rule "HV Net-(C13a201-Pad1) -> GND"
	(constraint clearance (min 4.54mm))
	(condition "(A.NetName == 'Net-(C13a201-Pad1)' && B.NetName == 'GND') || (A.NetName == 'GND' && B.NetName == 'Net-(C13a201-Pad1)')"))

(rule "HV −HV_out -> GND"
	(constraint clearance (min 4.5mm))
	(condition "(A.NetName == '−HV_out' && B.NetName == 'GND') || (A.NetName == 'GND' && B.NetName == '−HV_out')"))

